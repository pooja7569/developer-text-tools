{
  "manifest_version": 3,
  "name": "Local Django Popup",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting"],
  "description": "A React popup connected to a local Django API.",
  "key": "",
  "action": {
    "default_title": "Local Django Popup",
    "default_popup": "index.html"
  },
  "host_permissions": ["http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8000"
  }
}
