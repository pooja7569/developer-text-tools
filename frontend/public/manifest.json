{
  "manifest_version": 3,
  "name": "DevToolBox",
  "version": "1.1.0",
  "minimum_chrome_version": "141",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "description": "Inspect JSON, convert YAML, decode JWTs, compare API responses, and save a local workspace.",
  "key": "",
  "action": {
    "default_title": "DevToolBox",
    "default_popup": "index.html"
  },
  "side_panel": { "default_path": "index.html?view=side-panel" },
  "background": { "service_worker": "background.js", "type": "module" },
  "host_permissions": ["http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8000"
  }
}
